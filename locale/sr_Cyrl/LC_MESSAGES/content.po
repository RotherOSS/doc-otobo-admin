#: ../content/glossary.rst:4
msgid "Activity"
msgstr ""

#: ../content/glossary.rst:6 ../content/glossary.rst:69
#: ../content/glossary.rst:72 ../content/glossary.rst:84
msgid "Part of the process management."
msgstr ""

#: ../content/glossary.rst:7
msgid "Agent"
msgstr ""

#: ../content/glossary.rst:9
msgid "An agent is a user which services customer users. The person working for your organization."
msgstr ""

#: ../content/glossary.rst:10
msgid "Back end"
msgstr ""

#: ../content/glossary.rst:12
msgid "A configuration file, module, script or other functional item within OTOBO which is not reachable via the browser."
msgstr ""

#: ../content/glossary.rst:15
msgid "Defines working hours, time-zone, and holidays to be applied when using :term:`escalation times`."
msgstr ""

#: ../content/glossary.rst:16
msgid "Customer"
msgstr ""

#: ../content/glossary.rst:18
msgid "Physical organizations to which customer users are assigned. These provide the function to group users together which belong to a single organization."
msgstr ""

#: ../content/glossary.rst:19
msgid "Customer User"
msgstr ""

#: ../content/glossary.rst:21
msgid "Physical persons, and their contact data, which belong to a customer. These are the people raising tickets."
msgstr ""

#: ../content/glossary.rst:22
msgid "Dynamic Field"
msgstr ""

#: ../content/glossary.rst:24
msgid "A field used in tickets and articles to extend the data which can be saved in a ticket or article. They are saved from values in the database or accessed from outside resources."
msgstr ""

#: ../content/glossary.rst:25
msgid "Escalation Times"
msgstr ""

#: ../content/glossary.rst:27
msgid "The defined amount of working time before a ticket breaches an agreement."
msgstr ""

#: ../content/glossary.rst:28
msgid "Front end"
msgstr ""

#: ../content/glossary.rst:30
msgid "The graphical interface to OTOBO as viewed in a browser."
msgstr ""

#: ../content/glossary.rst:31
msgid "Group"
msgstr ""

#: ../content/glossary.rst:33
msgid "This is a resource within OTOBO. An :term:`agent` or a :term:`customer` can be assigned permissions to this resource as needed. Additionally, they can be used for access control, processes and web services."
msgstr ""

#: ../content/glossary.rst:34
msgid "Invoker"
msgstr ""

#: ../content/glossary.rst:36
msgid "An invoker is a special Perl module which allows OTOBO to provide information to a remote system via REST or HTTP. Invokers must be developed in Perl by a back end developer."
msgstr ""

#: ../content/glossary.rst:37
msgid "Mapping"
msgstr ""

#: ../content/glossary.rst:39
msgid "A mapping allows OTOBO to provide inbound and outbound translation of data allowing us to offer a specific data construction to rebuild incoming structures to meet our needs."
msgstr ""

#: ../content/glossary.rst:40
msgid "Operation"
msgstr ""

#: ../content/glossary.rst:42
msgid "Similar to a web hook, a provider operation offers a specific sub-set of OTOBO Perl API functionality to external systems."
msgstr ""

#: ../content/glossary.rst:43
msgid "Process"
msgstr ""

#: ../content/glossary.rst:45
msgid "Part of the process management. A process defines the workflow for a task and consists of activities, activity dialogs, transitions and transition actions."
