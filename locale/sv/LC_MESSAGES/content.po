#: ../content/glossary.rst:2
msgid "Glossary"
msgstr ""

#: ../content/glossary.rst:4
msgid "Activity"
msgstr ""

#: ../content/glossary.rst:6 ../content/glossary.rst:80
#: ../content/glossary.rst:83 ../content/glossary.rst:98
msgid "Part of the process management."
msgstr ""

#: ../content/glossary.rst:7
msgid "Agent"
msgstr ""

#: ../content/glossary.rst:9
msgid "An agent is a user which services customer users. The person working for your organization."
msgstr ""

#: ../content/glossary.rst:11
msgid "Back end"
msgstr ""

#: ../content/glossary.rst:13
msgid "A configuration file, module, script or other functional item within OTOBO which is not reachable via the browser."
msgstr ""

#: ../content/glossary.rst:16
msgid "Defines working hours, time-zone, and holidays to be applied when using :term:`escalation times`."
msgstr ""

#: ../content/glossary.rst:17
msgid "Customer"
msgstr ""

#: ../content/glossary.rst:19
msgid "Physical organizations to which customer users are assigned. These provide the function to group users together which belong to a single organization."
msgstr ""

#: ../content/glossary.rst:21
msgid "Customer User"
msgstr ""

#: ../content/glossary.rst:23
msgid "Physical persons, and their contact data, which belong to a customer. These are the people raising tickets."
msgstr ""

#: ../content/glossary.rst:25
msgid "Dynamic Field"
msgstr ""

#: ../content/glossary.rst:27
msgid "A field used in tickets and articles to extend the data which can be saved in a ticket or article. They are saved from values in the database or accessed from outside resources."
msgstr ""

#: ../content/glossary.rst:29
msgid "Escalation Times"
msgstr ""

#: ../content/glossary.rst:31
msgid "The defined amount of working time before a ticket breaches an agreement."
msgstr ""

#: ../content/glossary.rst:32
msgid "Front end"
msgstr ""

#: ../content/glossary.rst:34
msgid "The graphical interface to OTOBO as viewed in a browser."
msgstr ""

#: ../content/glossary.rst:35
msgid "Group"
msgstr ""

#: ../content/glossary.rst:37
msgid "This is a resource within OTOBO. An :term:`agent` or a :term:`customer` can be assigned permissions to this resource as needed. Additionally, they can be used for access control, processes and web services."
msgstr ""

#: ../content/glossary.rst:40
msgid "Invoker"
msgstr ""

#: ../content/glossary.rst:42
msgid "An invoker is a special Perl module which allows OTOBO to provide information to a remote system via REST or HTTP. Invokers must be developed in Perl by a back end developer."
msgstr ""

#: ../content/glossary.rst:44
msgid "Mapping"
msgstr ""

#: ../content/glossary.rst:46
msgid "A mapping allows OTOBO to provide inbound and outbound translation of data allowing us to offer a specific data construction to rebuild incoming structures to meet our needs."
msgstr ""

#: ../content/glossary.rst:47
msgid "Operation"
msgstr ""

#: ../content/glossary.rst:49
msgid "Similar to a web hook, a provider operation offers a specific sub-set of OTOBO Perl API functionality to external systems."
msgstr ""

#: ../content/glossary.rst:50
msgid "Process"
msgstr ""

#: ../content/glossary.rst:52
msgid "Part of the process management. A process defines the workflow for a task and consists of activities, activity dialogs, transitions and transition actions."
msgstr ""

#: ../content/glossary.rst:56
msgid "Part of OTOBO to support definition of workflows for recurring tasks."
msgstr ""

#: ../content/glossary.rst:57
msgid "Process Path"
msgstr ""

#: ../content/glossary.rst:59
msgid "Part of the process management. A process path describes the connections between the parts of a process."
msgstr ""

#: ../content/glossary.rst:63
msgid "A resource is any object which has effective permissions. This can be, but is not limited to, a ticket, dashboard widget, statistic, or module."
msgstr ""

#: ../content/glossary.rst:65
msgid "Screen"
msgstr ""

#: ../content/glossary.rst:67
msgid "A graphical interface to OTOBO viewed in a browser (see also :term:`Front end`)."
msgstr ""

#: ../content/glossary.rst:70
msgid "A means of delivering added value to customers by making it easier for customers or helping them to achieve their desired results without them having to personally bear the responsibility for specific costs and risks."
msgstr ""

#: ../content/glossary.rst:71
msgid "Service Level Agreement"
msgstr ""

#: ../content/glossary.rst:73
msgid "A service level agreement (SLA) is a contract between a service provider (either internal or external) and the end user that defines the level of service expected from the service provider. SLAs are output-based in that their purpose is specifically to define what the customer will receive."
msgstr ""

#: ../content/glossary.rst:75
msgid "Service Request"
msgstr ""

#: ../content/glossary.rst:77
msgid "(see also :term:`Ticket`)."
msgstr ""

#: ../content/glossary.rst:78
msgid "Transition"
msgstr ""

#: ../content/glossary.rst:81
msgid "Transition Action"
msgstr ""

#: ../content/glossary.rst:84
msgid "SLA"
msgstr ""

#: ../content/glossary.rst:86
msgid "(see also :term:`Service Level Agreement`)."
msgstr ""

#: ../content/glossary.rst:89
msgid "A ticket is a collection of all communications with a customer during the course of a service request. A ticket contains articles, which are the communication received from or sent to customers, agents, external systems, etc. Tickets belong to a customer user, are assigned to agents and reside in queues."
msgstr ""

#: ../content/glossary.rst:92
msgid "Transport"
msgstr ""

#: ../content/glossary.rst:94
msgid "A transport is the method chosen for communication. OTOBO supports REST and SOAP."
msgstr ""

#: ../content/glossary.rst:96
msgid "Activity Dialog"
msgstr ""

#: ../content/glossary.rst:99
msgid "Working Time"
msgstr ""

#: ../content/glossary.rst:101
msgid "A definition of minutes passed during the defined working hours of any :term:`calendar`."
msgstr ""

