#: ../content/administration-area/processes-automation/web-services.rst:4
msgid "In a connected world, a ticket system needs to be able to react to requests from other systems and also to send requests or information to other systems:"
msgstr ""

#: ../content/administration-area/processes-automation/web-services.rst:6
msgid "CRM systems"
msgstr ""

#: ../content/administration-area/processes-automation/web-services.rst:7
msgid "Project management systems"
msgstr ""

#: ../content/administration-area/processes-automation/web-services.rst:8
