msgstr ""

#: ../content/administration-area/communication-notifications/postmaster-filters.rst:163
msgid "Set the priority for the ticket."
msgstr ""

#: ../content/administration-area/communication-notifications/postmaster-filters.rst:168
msgid "``X-OTOBO-Queue``"
msgstr ""

#: ../content/administration-area/communication-notifications/postmaster-filters.rst:166
msgid "Set the queue where the ticket shall be sorted. If this is set, all other filter rules that try to sort a ticket into a specific queue are ignored. If you use a sub-queue, specify it as *Parent::Sub*."
msgstr ""

#: ../content/administration-area/communication-notifications/postmaster-filters.rst:171
msgid "``X-OTOBO-Responsible``"
msgstr ""

#: ../content/administration-area/communication-notifications/postmaster-filters.rst:171
msgid "Set the agent as responsible for the ticket."
msgstr ""

#: ../content/administration-area/communication-notifications/postmaster-filters.rst:174
msgid "``X-OTOBO-ResponsibleID``"
msgstr ""

#: ../content/administration-area/communication-notifications/postmaster-filters.rst:174
msgid "Set the agent ID as responsible for the ticket."
msgstr ""

#: ../content/administration-area/communication-notifications/postmaster-filters.rst:178
msgid "``X-OTOBO-SenderType``"
msgstr ""

#: ../content/administration-area/communication-notifications/postmaster-filters.rst:177
msgid "Set the sender type for the ticket. Possible values are ``agent``, ``system`` or ``customer``."
msgstr ""

#: ../content/administration-area/communication-notifications/postmaster-filters.rst:182
msgid "``X-OTOBO-Service``"
msgstr ""

#: ../content/administration-area/communication-notifications/postmaster-filters.rst:181
msgid "Set the service for the ticket. If you use a sub-service, specify it as *Parent::Sub*."
msgstr ""

#: ../content/administration-area/communication-notifications/postmaster-filters.rst:185
msgid "``X-OTOBO-SLA``"
msgstr ""

#: ../content/administration-area/communication-notifications/postmaster-filters.rst:185
msgid "Set the service level agreement for the ticket."
msgstr ""

#: ../content/administration-area/communication-notifications/postmaster-filters.rst:188
msgid "``X-OTOBO-State``"
msgstr ""

#: ../content/administration-area/communication-notifications/postmaster-filters.rst:188
msgid "Set the state for the ticket."
msgstr ""

#: ../content/administration-area/communication-notifications/postmaster-filters.rst:198
msgid "``X-OTOBO-State-PendingTime``"
msgstr ""

#: ../content/administration-area/communication-notifications/postmaster-filters.rst:191
msgid "Set the pending time for the ticket (you should sent a pending state via ``X-OTOBO-State``). You can specify absolute dates like *2010-11-20 00:00:00* or relative dates, based on the arrival time of the email. Use the form ``+ $Number $Unit``, where ``$Unit`` can be *s* (seconds), *m* (minutes), *h* (hours) or *d* (days). Only one unit can be specified. Examples of valid settings: *+50s* (pending in 50 seconds), *+30m* (30 minutes), *+12d* (12 days)."
msgstr ""

#: ../content/administration-area/communication-notifications/postmaster-filters.rst:197
msgid "Settings like *+1d 12h* are not possible. You can specify *+36h* instead."
