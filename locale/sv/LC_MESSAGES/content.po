#: ../content/administration-area/communication-notifications/postmaster-filters.rst:201
msgid "``X-OTOBO-Title``"
msgstr ""

#: ../content/administration-area/communication-notifications/postmaster-filters.rst:201
msgid "Set the title for the ticket."
msgstr ""

#: ../content/administration-area/communication-notifications/postmaster-filters.rst:204
msgid "``X-OTOBO-Type``"
msgstr ""

#: ../content/administration-area/communication-notifications/postmaster-filters.rst:204
msgid "Set the type for the ticket."
msgstr ""

